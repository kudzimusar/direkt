{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://direkt.forum/schemas/phase11-wave0-evidence-manifest.schema.json",
  "title": "DIREKT Phase 11 Wave 0 Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "as_of",
    "source_baseline",
    "pilot_entry_approved",
    "primary_pilot_evidence_count",
    "technical_preflight",
    "decision",
    "gates"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "as_of": { "type": "string", "format": "date-time" },
    "source_baseline": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "pilot_entry_approved": { "const": false },
    "primary_pilot_evidence_count": { "const": 0 },
    "technical_preflight": {
      "enum": ["IMPLEMENTED_PENDING_EXACT_HEAD", "PASSED", "FAILED"]
    },
    "decision": {
      "enum": ["ENTRY_APPROVED", "ENTRY_BLOCKED_EXTERNAL", "ENTRY_BLOCKED_TECHNICAL", "STOP"]
    },
    "gates": {
      "type": "array",
      "minItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "class",
          "state",
          "authority",
          "evidence_reference",
          "evidence_sha256",
          "scope",
          "decision_owner",
          "decision_at",
          "independent_reviewer",
          "expires_at",
          "blocks"
        ],
        "properties": {
          "id": { "pattern": "^P11-(G|C)[0-9]{2}$" },
          "class": { "enum": ["HARD", "CONDITIONAL"] },
          "state": { "enum": ["OPEN", "CLOSED", "NOT_APPLICABLE", "DISABLED", "FAILED"] },
          "authority": { "type": ["string", "null"] },
          "evidence_reference": { "type": ["string", "null"] },
          "evidence_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "scope": { "type": ["string", "null"] },
          "decision_owner": { "type": ["string", "null"] },
          "decision_at": { "type": ["string", "null"], "format": "date-time" },
          "independent_reviewer": { "type": ["string", "null"] },
          "expires_at": { "type": ["string", "null"], "format": "date-time" },
          "blocks": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
